{
  "git_master": {
    "commit_footer": true,
    "include_co_authored_by": true,
    "git_env_prefix": "GIT_MASTER=1"
  },
  "agents": {
    "sisyphus": {
      "model": "anthropic/claude-opus-5",
      "ultrawork": {
        "model": "anthropic/claude-opus-5",
        "reasoning": "max"
      }
    },
    "hephaestus": {
      "model": "openai/gpt-5.6-sol"
    },
    "prometheus": {},
    "oracle": {
      "model": "openai/gpt-5.6-sol",
      "reasoning": "high"
    },
    "metis": {},
    "momus": {},
    "sisyphus-junior": {
      "model": "opencode/gpt-5-nano"
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "anthropic/claude-opus-5",
      "reasoning": "max"
    },
    "ultrabrain": {
      "model": "openai/gpt-5.6-sol",
      "reasoning": "xhigh"
    },
    "deep": {
      "model": "openai/gpt-5.6-sol",
      "reasoning": "medium"
    },
    "quick": {
      "model": "opencode/gpt-5-nano"
    },
    "unspecified-low": {
      "model": "openai/gpt-5.6-luna",
      "reasoning": "xhigh"
    },
    "unspecified-high": {
      "model": "anthropic/claude-opus-5",
      "reasoning": "max"
    },
    "writing": {
      "model": "kimi-for-coding/kimi-k3",
      "reasoning": "low"
    }
  },
  "background_task": {
    "providerConcurrency": {
      "anthropic": 3,
      "openai": 3,
      "google": 5,
      "opencode": 10
    }
  },
  "experimental": {
    "aggressive_truncation": true
  }
}
